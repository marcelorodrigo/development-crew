{
  "name": "@marcelorodrigo/opencode-development-crew",
  "version": "0.8.2",
  "description": "Development agents for opencode: Orchestrator, Rubber Duck, Architect, Implementer and Code Reviewer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "development",
    "clean-architecture"
  ],
  "author": "Marcelo Rodrigo",
  "contributors": [
    "Lucas Germani"
  ],
  "license": "MIT",
  "homepage": "https://github.com/marcelorodrigo/development-crew",
  "devDependencies": {
    "@opencode-ai/plugin": "1.17.4",
    "@opencode-ai/sdk": "1.17.7",
    "tsup": "^8.0.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelorodrigo/development-crew.git"
  }
}
